  "input_image_size": [
    224,
    224,
    3
  ],
  "optimizer": "AdamW",
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "batch_size": 8,
  "epochs": 20,
  "loss_function": "binary_crossentropy",
  "metrics": [
    "accuracy",
    "precision",
    "recall"
